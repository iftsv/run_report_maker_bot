[Unit]
Description=Run Report Maker Bot
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/home/user/run_report_maker_bot
ExecStart=/home/user/run_report_maker_bot/venv/bin/python3 main.py
Restart=always
EnvironmentFile=/home/user/run_report_maker_bot/.env

[Install]
WantedBy=multi-user.target
